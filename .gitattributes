# Detect text automatically; preserve binary Unity assets byte-for-byte.
* text=auto

# Source and Unity YAML: stable line endings for readable diffs.
*.cs text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Game art and sound are binary, even when a file contains incidental newlines.
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.fbx binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.ttf binary
*.otf binary
*.dll binary
